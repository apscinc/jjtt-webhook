<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>JJTT 기부 나무</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400&family=Noto+Sans+KR:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;background:#f5f0e8;font-family:'Noto Sans KR',sans-serif}
.page{max-width:600px;margin:0 auto;padding:28px 20px 48px}

.hd{text-align:center;margin-bottom:22px}
.hd-tag{display:inline-block;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.3em;color:#8a6a2a;border:1px solid rgba(138,106,42,.3);padding:5px 14px;margin-bottom:10px}
.hd-title{font-family:'Bebas Neue',sans-serif;font-size:34px;letter-spacing:.05em;color:#2a2018}
.hd-sub{font-size:12px;color:rgba(42,32,24,.5);margin-top:5px;letter-spacing:.03em}

.tree-box{position:relative;width:100%;border-radius:14px;overflow:hidden;box-shadow:0 6px 32px rgba(0,0,0,.1),0 1px 6px rgba(0,0,0,.06)}
#tree-svg{width:100%;display:block}

.counter{position:absolute;top:18px;right:20px;text-align:right;pointer-events:none}
.counter-num{font-family:'Bebas Neue',sans-serif;font-size:44px;color:#2a2018;line-height:1;text-shadow:0 1px 4px rgba(255,255,255,.85)}
.counter-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.12em;color:rgba(42,32,24,.45)}

.legend{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.leg-item{display:flex;align-items:center;gap:10px;background:white;border-radius:10px;padding:10px 14px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.leg-dot{width:11px;height:11px;border-radius:50%;flex-shrink:0}
.leg-name{font-size:11px;font-weight:500;color:#2a2018;line-height:1.3}
.leg-cnt{font-family:'DM Mono',monospace;font-size:10px;color:rgba(42,32,24,.42);margin-top:2px}

.share-btn{display:block;width:100%;margin-top:12px;padding:12px;background:white;border:1px solid rgba(138,106,42,.2);border-radius:10px;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.12em;color:#8a6a2a;cursor:pointer;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.05);transition:background .2s}
.share-btn:hover{background:#faf8f2}
.share-btn.copied{background:#f0f8ec;color:#4a7a30;border-color:rgba(74,122,48,.3)}

.ft{text-align:center;margin-top:18px;font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.18em;color:rgba(42,32,24,.28)}

@keyframes flyIn{
  0%{opacity:0;transform:translate(-55px,28px) scale(.55)}
  62%{opacity:1;transform:translate(4px,-4px) scale(1.05)}
  100%{opacity:1;transform:translate(0,0) scale(1)}
}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-2.5px)}}
@keyframes sway{0%,100%{transform:rotate(0deg)}50%{transform:rotate(1.2deg)}}

.bird-g{animation:flyIn .88s cubic-bezier(.34,1.56,.64,1) both}
.bird-bd{animation:bob var(--bd,3s) ease-in-out infinite var(--dd,0s)}
.leaf-g{transform-origin:295px 490px;animation:sway var(--sw,6s) ease-in-out infinite var(--sd,0s)}
</style>
</head>
<body>
<div class="page">

  <div class="hd">
    <div class="hd-tag">JJTT — GIVING TREE</div>
    <div class="hd-title">함께 채워가는 나무</div>
    <div class="hd-sub">양말 한 켤레가 새 한 마리가 됩니다</div>
  </div>

  <div class="tree-box">
    <div class="counter">
      <div class="counter-num" id="cnt">0</div>
      <div class="counter-label">총 적립 켤레</div>
    </div>

    <svg id="tree-svg" viewBox="0 0 600 660" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="skyG" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"  stop-color="#cce2f5"/>
          <stop offset="52%" stop-color="#e2efda"/>
          <stop offset="100%" stop-color="#ede4d0"/>
        </linearGradient>
        <linearGradient id="trkG" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"  stop-color="#5a3415"/>
          <stop offset="42%" stop-color="#7c4e2c"/>
          <stop offset="100%" stop-color="#5a3415"/>
        </linearGradient>
        <filter id="lf" x="-12%" y="-12%" width="124%" height="124%">
          <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="rgba(0,50,0,.16)"/>
        </filter>
      </defs>

      <!-- Sky -->
      <rect width="600" height="660" fill="url(#skyG)"/>

      <!-- Clouds -->
      <g opacity=".5">
        <ellipse cx="75"  cy="68"  rx="42" ry="23" fill="white"/>
        <ellipse cx="108" cy="58"  rx="33" ry="21" fill="white"/>
        <ellipse cx="48"  cy="62"  rx="28" ry="17" fill="white"/>
        <ellipse cx="472" cy="88"  rx="40" ry="22" fill="white"/>
        <ellipse cx="506" cy="78"  rx="32" ry="19" fill="white"/>
        <ellipse cx="444" cy="82"  rx="26" ry="16" fill="white"/>
      </g>

      <!-- Ground -->
      <ellipse cx="300" cy="645" rx="286" ry="33" fill="#c2ac74" opacity=".38"/>
      <ellipse cx="300" cy="654" rx="212" ry="20" fill="#b09a62" opacity=".28"/>

      <!-- Grass tufts -->
      <g fill="#68a03a" opacity=".5">
        <path d="M52,626 Q58,602 66,626"/><path d="M72,629 Q80,608 88,629"/>
        <path d="M98,632 Q103,618 110,632"/>
        <path d="M498,625 Q505,602 514,625"/><path d="M518,629 Q526,607 534,629"/>
        <path d="M198,634 Q203,620 210,634"/>
        <path d="M376,633 Q382,619 390,633"/>
      </g>

      <!-- Trunk -->
      <path d="M286,648 C283,598 281,552 283,508 C286,468 292,430 290,393 C288,360 284,328 288,296"
            stroke="url(#trkG)" stroke-width="35" fill="none" stroke-linecap="round"/>
      <path d="M282,588 C284,566 285,546 283,526" stroke="#4a2810" stroke-width="2" fill="none" opacity=".28" stroke-linecap="round"/>
      <path d="M292,553 C294,532 295,513 293,496" stroke="#4a2810" stroke-width="1.5" fill="none" opacity=".22" stroke-linecap="round"/>
      <path d="M284,473 C286,452 288,435 287,418" stroke="#4a2810" stroke-width="1.5" fill="none" opacity=".26" stroke-linecap="round"/>

      <!-- Roots -->
      <path d="M283,642 C250,638 213,640 184,648" stroke="#69401e" stroke-width="12" fill="none" stroke-linecap="round" opacity=".38"/>
      <path d="M290,644 C326,640 364,642 394,650" stroke="#69401e" stroke-width="10" fill="none" stroke-linecap="round" opacity=".33"/>
      <path d="M281,639 C256,635 235,637 218,644" stroke="#69401e" stroke-width="7" fill="none" stroke-linecap="round" opacity=".28"/>

      <!-- Branch CAT1 (top-left) -->
      <path d="M287,332 C261,329 228,318 196,300 C165,283 138,262 110,238"
            stroke="#69401e" stroke-width="18" fill="none" stroke-linecap="round"/>
      <path d="M173,281 C152,260 132,238 110,216"
            stroke="#69401e" stroke-width="10" fill="none" stroke-linecap="round"/>
      <path d="M198,300 C177,277 160,256 146,233"
            stroke="#69401e" stroke-width="9" fill="none" stroke-linecap="round"/>

      <!-- Branch CAT2 (top-right) -->
      <path d="M293,327 C319,324 354,312 388,295 C420,279 450,258 480,234"
            stroke="#69401e" stroke-width="18" fill="none" stroke-linecap="round"/>
      <path d="M427,276 C448,255 467,235 486,214"
            stroke="#69401e" stroke-width="10" fill="none" stroke-linecap="round"/>
      <path d="M400,294 C420,272 436,254 450,232"
            stroke="#69401e" stroke-width="9" fill="none" stroke-linecap="round"/>

      <!-- Branch CAT3 (mid-left) -->
      <path d="M285,430 C258,426 226,418 193,404 C161,390 131,376 102,360"
            stroke="#69401e" stroke-width="14" fill="none" stroke-linecap="round"/>
      <path d="M166,392 C146,375 126,357 108,340"
            stroke="#69401e" stroke-width="8" fill="none" stroke-linecap="round"/>

      <!-- Branch CAT4 (mid-right) -->
      <path d="M295,428 C323,424 356,416 390,402 C422,388 452,374 480,358"
            stroke="#69401e" stroke-width="14" fill="none" stroke-linecap="round"/>
      <path d="M434,390 C454,373 472,356 490,340"
            stroke="#69401e" stroke-width="8" fill="none" stroke-linecap="round"/>

      <!-- Leaves CAT1 (top-left) -->
      <g class="leaf-g" style="--sw:6.8s;--sd:-1s" filter="url(#lf)">
        <ellipse cx="110" cy="226" rx="70" ry="56" fill="#3c6c33" opacity=".92"/>
        <ellipse cx="143" cy="247" rx="57" ry="47" fill="#4d8840" opacity=".88"/>
        <ellipse cx="80"  cy="244" rx="53" ry="45" fill="#346030" opacity=".83"/>
        <ellipse cx="116" cy="210" rx="52" ry="43" fill="#5a9847" opacity=".78"/>
        <ellipse cx="156" cy="231" rx="45" ry="38" fill="#448036" opacity=".85"/>
        <ellipse cx="86"  cy="218" rx="41" ry="35" fill="#3d7033" opacity=".76"/>
        <ellipse cx="126" cy="204" rx="30" ry="24" fill="#70b055" opacity=".44"/>
      </g>

      <!-- Leaves CAT2 (top-right) -->
      <g class="leaf-g" style="--sw:5.8s;--sd:-3s" filter="url(#lf)">
        <ellipse cx="482" cy="222" rx="70" ry="56" fill="#3c6c33" opacity=".92"/>
        <ellipse cx="449" cy="243" rx="57" ry="47" fill="#4d8840" opacity=".88"/>
        <ellipse cx="512" cy="240" rx="53" ry="45" fill="#346030" opacity=".83"/>
        <ellipse cx="476" cy="208" rx="52" ry="43" fill="#5a9847" opacity=".78"/>
        <ellipse cx="440" cy="228" rx="45" ry="38" fill="#448036" opacity=".85"/>
        <ellipse cx="508" cy="216" rx="41" ry="35" fill="#3d7033" opacity=".76"/>
        <ellipse cx="472" cy="200" rx="30" ry="24" fill="#70b055" opacity=".44"/>
      </g>

      <!-- Leaves CAT3 (mid-left) -->
      <g class="leaf-g" style="--sw:7.2s;--sd:-5s" filter="url(#lf)">
        <ellipse cx="102" cy="346" rx="60" ry="48" fill="#3c6c33" opacity=".92"/>
        <ellipse cx="132" cy="364" rx="50" ry="41" fill="#4d8840" opacity=".88"/>
        <ellipse cx="74"  cy="360" rx="47" ry="40" fill="#346030" opacity=".83"/>
        <ellipse cx="108" cy="330" rx="46" ry="39" fill="#5a9847" opacity=".78"/>
        <ellipse cx="140" cy="350" rx="42" ry="34" fill="#448036" opacity=".84"/>
        <ellipse cx="78"  cy="337" rx="36" ry="31" fill="#3d7033" opacity=".72"/>
        <ellipse cx="113" cy="323" rx="26" ry="21" fill="#70b055" opacity=".42"/>
      </g>

      <!-- Leaves CAT4 (mid-right) -->
      <g class="leaf-g" style="--sw:6.2s;--sd:-2s" filter="url(#lf)">
        <ellipse cx="480" cy="344" rx="60" ry="48" fill="#3c6c33" opacity=".92"/>
        <ellipse cx="450" cy="362" rx="50" ry="41" fill="#4d8840" opacity=".88"/>
        <ellipse cx="508" cy="358" rx="47" ry="40" fill="#346030" opacity=".83"/>
        <ellipse cx="476" cy="328" rx="46" ry="39" fill="#5a9847" opacity=".78"/>
        <ellipse cx="444" cy="348" rx="42" ry="34" fill="#448036" opacity=".84"/>
        <ellipse cx="504" cy="335" rx="36" ry="31" fill="#3d7033" opacity=".72"/>
        <ellipse cx="479" cy="321" rx="26" ry="21" fill="#70b055" opacity=".42"/>
      </g>

      <!-- Leaves center top -->
      <g class="leaf-g" style="--sw:5.5s;--sd:-4s" filter="url(#lf)">
        <ellipse cx="290" cy="282" rx="66" ry="53" fill="#386830" opacity=".89"/>
        <ellipse cx="258" cy="298" rx="52" ry="42" fill="#488040" opacity=".85"/>
        <ellipse cx="322" cy="296" rx="52" ry="42" fill="#488040" opacity=".85"/>
        <ellipse cx="290" cy="265" rx="48" ry="40" fill="#5c9850" opacity=".78"/>
        <ellipse cx="290" cy="255" rx="30" ry="24" fill="#70b055" opacity=".44"/>
      </g>

      <!-- Perch dots (empty slots) -->
      <g id="perch-dots"/>
      <!-- Birds -->
      <g id="birds"/>

    </svg>
  </div>

  <div class="legend">
    <div class="leg-item">
      <div class="leg-dot" style="background:#4a95c0"></div>
      <div><div class="leg-name">취약계층 아동·노인</div><div class="leg-cnt" id="l-cat1">0 켤레</div></div>
    </div>
    <div class="leg-item">
      <div class="leg-dot" style="background:#d96030"></div>
      <div><div class="leg-name">소방·구급대</div><div class="leg-cnt" id="l-cat2">0 켤레</div></div>
    </div>
    <div class="leg-item">
      <div class="leg-dot" style="background:#3ea060"></div>
      <div><div class="leg-name">노숙인</div><div class="leg-cnt" id="l-cat3">0 켤레</div></div>
    </div>
    <div class="leg-item">
      <div class="leg-dot" style="background:#9f4eb8"></div>
      <div><div class="leg-name">사회복지사</div><div class="leg-cnt" id="l-cat4">0 켤레</div></div>
    </div>
  </div>

  <button class="share-btn" id="share-btn" onclick="copyLink()">
    🔗 &nbsp; 링크 복사해서 공유하기
  </button>

  <div class="ft">JJTT — BUY ONE GIVE ONE &nbsp;·&nbsp; jacktweet.com</div>
</div>

<script>
const API = 'https://jjtt-webhook.vercel.app/api/status';
const GOAL = 2000;
const MAX = 10;

const CFG = {
  cat1:{color:'#4a95c0',perches:[
    {x:258,y:313},{x:228,y:300},{x:198,y:286},
    {x:170,y:270},{x:145,y:254},{x:118,y:236},
    {x:160,y:257},{x:142,y:240},{x:176,y:264},
    {x:130,y:244}
  ]},
  cat2:{color:'#d96030',perches:[
    {x:340,y:310},{x:372,y:297},{x:402,y:282},
    {x:430,y:267},{x:454,y:252},{x:482,y:232},
    {x:438,y:258},{x:457,y:240},{x:420,y:267},
    {x:467,y:242}
  ]},
  cat3:{color:'#3ea060',perches:[
    {x:252,y:422},{x:220,y:410},{x:188,y:397},
    {x:157,y:384},{x:128,y:369},{x:102,y:352},
    {x:166,y:388},{x:140,y:373},{x:115,y:356},
    {x:94,y:342}
  ]},
  cat4:{color:'#9f4eb8',perches:[
    {x:347,y:420},{x:380,y:408},{x:412,y:396},
    {x:442,y:382},{x:468,y:368},{x:492,y:354},
    {x:430,y:384},{x:458,y:370},{x:480,y:354},
    {x:496,y:344}
  ]}
};

function birdN(n){ if(!n)return 0; return Math.max(1,Math.min(MAX,Math.floor(n/(GOAL/MAX)))); }

function makeBird(x,y,color,delay,flip){
  const s=.78, fx=flip?-1:1;
  return `<g class="bird-g" style="animation-delay:${delay}s">
<g class="bird-bd" style="--bd:${(2.5+Math.random()*2).toFixed(1)}s;--dd:${(Math.random()*2).toFixed(1)}s"
   transform="translate(${x},${y-11}) scale(${fx*s},${s})">
<path d="M-14,3 L-23,-2 L-21,7Z" fill="${color}" opacity=".84"/>
<ellipse cx="0" cy="0" rx="13" ry="9" fill="${color}"/>
<circle cx="14" cy="-6" r="8" fill="${color}"/>
<path d="M20,-5.5 L27,-4 L20,-2.5Z" fill="#8B5E3C"/>
<circle cx="15.5" cy="-7.5" r="2.2" fill="white"/>
<circle cx="16"   cy="-7.8" r="1.1" fill="#111"/>
<circle cx="16.8" cy="-8.4" r=".5"  fill="white"/>
<path d="M-4,-5 Q4,-14 12,-5" stroke="rgba(255,255,255,.3)" stroke-width="2" fill="none"/>
<path d="M-1,9 L-3,15 M-1,9 L1,15" stroke="#8B5E3C" stroke-width="1.5" fill="none" stroke-linecap="round"/>
<path d="M3,9 L1,15 M3,9 L5,15"    stroke="#8B5E3C" stroke-width="1.5" fill="none" stroke-linecap="round"/>
</g></g>`;
}

function makePerch(x,y){
  return `<circle cx="${x}" cy="${y-5}" r="2.8" fill="none" stroke="#a09070" stroke-width="1" opacity=".28"/>`;
}

function render(data){
  let birds='',dots='',delay=0,total=0;
  for(const[key,cfg]of Object.entries(CFG)){
    const cnt=(data[key]||{}).count||0;
    total+=cnt;
    const n=birdN(cnt);
    const el=document.getElementById('l-'+key);
    if(el)el.textContent=cnt.toLocaleString()+' 켤레';
    for(let i=0;i<MAX;i++){
      const p=cfg.perches[i];
      if(i<n){ birds+=makeBird(p.x,p.y,cfg.color,delay,i%3===0); delay+=.13; }
      else     dots+=makePerch(p.x,p.y);
    }
  }
  document.getElementById('birds').innerHTML=birds;
  document.getElementById('perch-dots').innerHTML=dots;

  const el=document.getElementById('cnt');
  const t0=performance.now(),dur=1500;
  const tick=now=>{
    const p=Math.min((now-t0)/dur,1);
    const e=1-Math.pow(1-p,3);
    el.textContent=Math.floor(e*total).toLocaleString();
    if(p<1)requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
}

function copyLink(){
  const url=window.location.href;
  navigator.clipboard.writeText(url).then(()=>{
    const btn=document.getElementById('share-btn');
    btn.textContent='✓  복사되었습니다!';
    btn.classList.add('copied');
    setTimeout(()=>{btn.textContent='🔗 \u00a0 링크 복사해서 공유하기';btn.classList.remove('copied');},2200);
  });
}

async function load(){
  let data={cat1:{count:0},cat2:{count:0},cat3:{count:0},cat4:{count:0}};
  try{
    const r=await fetch(API);
    const j=await r.json();
    if(j.success){
      data={};
      for(const[k,v]of Object.entries(j.data))data[k]={count:v.count||0};
    }
  }catch(e){console.warn('API 실패');}
  render(data);
}
load();
</script>
</body>
</html>
